# ==============================================================================
# LIENLIBRE — Variables d'environnement & Configuration Miroir
# ==============================================================================

# 1. Sécurité DNS (NextDNS)
# Créez gratuitement un compte sur https://nextdns.io, activez les filtres de sécurité
# (HaGeZi Multi, NRD, Contrôle parental) et collez votre ID à 6 caractères ici :
NEXTDNS_ID_PRIMARY=votre_id_nextdns_principal
NEXTDNS_ID_BACKUP=votre_id_nextdns_secours

# 2. Contact & Signalements
# Adresse courriel de contact affichée sur votre miroir pour les demandes de retrait :
CONTACT_EMAIL=contact@votre-domaine.org

# 3. Synchronisation Blocklist GitHub Actions
# Votre propre dépôt forké :
GITHUB_REPO=votre-pseudo/LienLibre
# Jeton d'accès GitHub personnel avec portée "repo" (pour déclencher auto-blocklist.yml) :
GITHUB_TOKEN=ghp_votre_token_personnel_github
