# ==============================================================================
# LIENLIBRE — Configuration Cloudflare Worker (Exemple pour les Forks / Miroirs)
# ==============================================================================
# Utilisez ce fichier pour déployer votre propre passerelle LienLibre autonome.
#
# ÉTAPES DE DÉPLOIEMENT :
# 1. Installez Wrangler : npm install -g wrangler
# 2. Connectez-vous à Cloudflare : wrangler login
# 3. Créez un profil NextDNS gratuit sur https://nextdns.io et copiez votre ID.
# 4. Renseignez vos identifiants ci-dessous dans [vars].
# 5. Déployez : wrangler deploy
# ==============================================================================

name = "mon-lienlibre-worker"
main = "worker.js"
compatibility_date = "2026-09-08"

# Variables d'environnement personnalisées (Modifiez avec vos propres identifiants)
[vars]
# ID de votre profil NextDNS principal (Gratuit sur https://nextdns.io)
NEXTDNS_ID_PRIMARY = "VOTRE_ID_NEXTDNS_1"

# ID de votre profil NextDNS de secours optionnel
NEXTDNS_ID_BACKUP = "VOTRE_ID_NEXTDNS_2"

# Votre adresse de courriel pour les signalements et avis de retrait
CONTACT_EMAIL = "contact@votre-domaine.org"

# Votre propre dépôt GitHub pour la synchronisation automatique de la blocklist
GITHUB_REPO = "votre-pseudo/LienLibre"

# Espace de stockage KV (Optionnel - Pour les statistiques et liens courts)
# [[kv_namespaces]]
# binding = "LIENLIBRE_KV"
# id = "VOTRE_KV_NAMESPACE_ID"
